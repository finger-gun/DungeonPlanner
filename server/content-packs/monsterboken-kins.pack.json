        "heroicAbilities": [
          {
            "ref": "monsterboken-kins:rule.heroic_ability.steadfast",
            "id": "steadfast",
            "name": "Steadfast",
            "wpCost": 3,
            "description": "Orcs are steadfast and stubborn, standing firm when others fall. An orc at 0 HP can activate this ability to automatically Rally (p.50 of the core rulebook), without needing to be persuaded by another character or rolling WIL. This ability is typically only used by player characters and important NPCs.",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.tackle",
            "id": "tackle",
            "name": "Tackle",
            "wpCost": 3,
            "description": "An ogre can use its massive body to tackle an opponent with violent force. This counts as an unarmed melee attack with a boon (advantage) that deals 2d6 bludgeoning damage (plus any damage bonus) and cannot be parried. The ogre may also sprint before the attack (but does not have to). Humanoid targets of Normal size or smaller that are hit are automatically knocked prone.",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.resilient",
            "id": "resilient",
            "name": "Resilient",
            "wpCost": 1,
            "description": "Goblins are hardy creatures that endure all manner of hardships. Activating this ability grants a boon (advantage) on a CON roll to resist poison or disease (p.52-53 of the core rulebook), or allows the goblin to skip the Bushcraft roll entirely when making camp (p.103 of the core rulebook). Additionally, goblins can always eat raw food without problems (no WP cost).",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.fearless",
            "id": "fearless",
            "name": "Fearless",
            "wpCost": 2,
            "description": "Hobgoblins are fearless and very few things scare them. A hobgoblin can activate this ability to automatically succeed on a WIL roll to resist fear (p.52 of the core rulebook). The ability must be activated before any dice are rolled.",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.leaper",
            "id": "leaper",
            "name": "Leaper",
            "wpCost": 3,
            "description": "Frog people can activate this ability to jump a horizontal distance equal to their movement value, or a vertical distance equal to half their movement value. No Acrobatics roll is needed. The jump can end with a melee attack, which then gets a boon (advantage).",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.wings",
            "id": "wings",
            "name": "Wings",
            "wpCost": 1,
            "description": "The karkion's bat-like wings allow it to fly through the air at the same speed as on foot, at a cost of 1 WP per round.",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.nine_lives",
            "id": "nine_lives",
            "name": "Nine Lives",
            "description": "Cat people have an incredible ability to survive even the worst ordeals. Activating this ability grants a boon (advantage) on a Death Roll (p.50 of the core rulebook) at a cost of 2 WP. The ability can also be used to reduce the number of d6 rolled for fall damage by one per WP spent, up to a maximum of three (after the Acrobatics roll to reduce damage, p.53 of the core rulebook).",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.camouflage",
            "id": "camouflage",
            "name": "Camouflage",
            "wpCost": 2,
            "description": "Lizard people who hide are difficult to detect. Activating this ability grants a boon (advantage) on a Sneaking skill roll.",
            "source": "DoD_Monsterboken_v1.pdf"
          },
          {
            "ref": "monsterboken-kins:rule.heroic_ability.encouragement",
            "id": "encouragement",
            "name": "Encouragement",
            "wpCost": 3,
            "description": "Satyrs are happy and positive creatures who gladly encourage their friends with song or poetry. Activating this ability is an action and removes one condition of choice from a person within earshot and 10 meters. The ability cannot be used on the satyr itself.",
            "source": "DoD_Monsterboken_v1.pdf"
          }
        ],
